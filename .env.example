# Copy to .env and set real values. Never commit .env.

APP_NAME=rpa-control-hub
DEBUG=false

# JWT (generate a long random string for production)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bootstrap admin (replace with DB-backed users later)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# MySQL (digital_workforce)
MYSQL_HOST=103.47.154.201
MYSQL_PORT=3306
MYSQL_USER=day3_fariz
MYSQL_PASSWORD=change-me
MYSQL_DB=digital_workforce

# QC recovery cron (server side)
QC_RECOVERY_ENABLED=false
QC_RECOVERY_INTERVAL_SECONDS=60
QC_RECOVERY_BATCH_SIZE=50

# Optional remote restart call per runner before trigger
# Use {runner_name}; add {service} only if your URL needs it (URL-encoded automatically).
# RUNNER_RESTART_URL_TEMPLATE=http://{runner_name}:8787/api/restart-service?service={service}

# Control Room device list polling (merge into GET /api/admin/bots/live)
CR_POLL_ENABLED=false
CR_POLL_INTERVAL_SECONDS=15
CR_BASE_SCHEME=http
CR_DEVICES_LIST_PATH=/v2/devices/list
CR_DEVICES_PAGE_LENGTH=500

# Control Room activity list (v3 In progress–style rows; merged per deviceName → RunnerName)
CR_ACTIVITY_LIST_PATH=/v3/activity/list
CR_ACTIVITY_PAGE_LENGTH=300
# Comma-separated Control Room status values → dashboard buckets (adjust to match your CR enums)
CR_ACTIVITY_STATUS_ACTIVE=RUNNING,RUN_PAUSED,DEPLOYED,STARTED,IN_PROGRESS,EXECUTING
CR_ACTIVITY_STATUS_QUEUED=QUEUED
CR_ACTIVITY_STATUS_PENDING=PENDING_EXECUTION,PENDING,DEPLOYING
